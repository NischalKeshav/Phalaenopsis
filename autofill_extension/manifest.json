{
  "manifest_version": 3,
  "name": "Phalaenopsis Autofill Memory",
  "version": "0.2.0",
  "description": "Graph-memory autofill: remembers page shapes and replays learned tool scripts without a model in the loop.",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "activeTab",
    "userScripts",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:7777/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/netwatch.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/fingerprint.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Open Phalaenopsis on this tab"
  }
}
